# Copy to .env (gitignored). Read by docker compose and passed to FreeFlight.

# Port the display is served on, on the ZimaOS box's LAN address
DISPLAY_PORT=8090
# Test-only port for the Phase 1 curl checks (DEBUG=1 ./start.sh), on 127.0.0.1 only
DEBUG_PORT=18000

# --- FreeFlight (https://github.com/Ethos6/free-flight-api/blob/main/.env.example) ---
# Community ADS-B networks to merge, in priority order
FREEFLIGHT_PROVIDERS=adsb.lol,airplanes.live,adsb.fi
# The display only needs nearby traffic, not the global OpenSky snapshot
FREEFLIGHT_OPENSKY=false
# How long area results are shared between clients (seconds)
FREEFLIGHT_CACHE_TTL=5
FREEFLIGHT_TIMEOUT=6
# Aircraft photos from planespotters.net (the display doesn't use them)
FREEFLIGHT_PHOTOS=false
# LAN-only and behind nginx: no keys or rate limit needed
FREEFLIGHT_API_KEYS=
FREEFLIGHT_RATE_LIMIT=0
